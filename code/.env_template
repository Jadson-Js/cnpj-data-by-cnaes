# --- Diretorios -------------------------------------------------------------
# Onde os .zip da Receita sao baixados
OUTPUT_FILES_PATH=/caminho/para/data/output_files
# Onde ficam os CSVs ja filtrados (padrao: <OUTPUT_FILES_PATH>/../partes_filtradas)
#PARTES_FILES_PATH=/caminho/para/data/partes_filtradas

# --- Filtro de CNAE ---------------------------------------------------------
# Lista de CNAEs desejados. Pode ser inline aqui e/ou no arquivo code/cnaes.txt.
# 7 digitos = CNAE exato; menos de 7 digitos = prefixo (ex.: 5611 pega 5611201/2/3).
#CNAE_LIST=5611201,5611203,4712100
#CNAE_ARQUIVO=/caminho/para/code/cnaes.txt

# Tambem trazer empresas cujo CNAE alvo aparece como atividade SECUNDARIA (padrao 1).
# Colocar 0 reduz bastante o volume.
CNAE_INCLUIR_SECUNDARIA=1

# Filtros extras opcionais (vazio = sem filtro)
#UF_LIST=SP,MG,RJ
# 01=Nula 02=Ativa 03=Suspensa 04=Inapta 08=Baixada
#SITUACAO_CADASTRAL=02

# --- Performance ------------------------------------------------------------
#PROC_WORKERS=6          # processos que filtram os CSVs em paralelo
#DOWNLOAD_WORKERS=4      # downloads simultaneos
#CHUNK_LINHAS=100000     # linhas por bloco lido em memoria
#APAGAR_ZIPS=0           # 1 = apaga cada .zip depois de filtrar (economiza disco)
#REPROCESSAR=0           # 1 = ignora o cache e refaz a filtragem de todos os arquivos
#MES_REFERENCIA=2026-08  # vazio = usa o mes mais recente publicado

# --- Saida ------------------------------------------------------------------
# NDJSON: um documento por linha, formato nativo do mongoimport. Termine em .gz
# para gravar comprimido. Use 0 para nao gerar o arquivo.
# Padrao: <OUTPUT_FILES_PATH>/../empresas_cnae.ndjson.gz
#EXPORT_NDJSON_PATH=/caminho/para/data/empresas_cnae.ndjson.gz

# MongoDB: se preenchido, os documentos tambem sao inseridos direto na collection.
# Vazio = so gera o NDJSON, para importar depois com mongoimport.
#MONGO_URI=mongodb://usuario:senha@localhost:27017/meubanco?authSource=admin
#MONGO_DB=                 # vazio = usa o banco da propria URI
MONGO_COLLECTION=reseller_shop
#MONGO_BATCH=5000          # documentos por insert_many
#MONGO_SWAP=1              # 1 = carrega numa collection temporaria e so troca no fim
